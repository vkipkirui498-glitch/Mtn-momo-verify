<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MTN Training Demo</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f5f5f5;color:#222}
.bar{background:#ffcc00;padding:18px 20px;font-weight:800;font-size:22px}
.wrap{max-width:460px;margin:42px auto;padding:20px}.card{background:#fff;border-radius:16px;padding:28px;box-shadow:0 5px 22px rgba(0,0,0,.1)}
.badge{display:inline-block;background:#fff3b0;border:1px solid #e3c400;padding:6px 10px;border-radius:999px;font-size:12px;font-weight:700}
h1{margin:16px 0 8px;font-size:25px}p{line-height:1.5;color:#555}
input{width:100%;padding:14px;border:1px solid #ccc;border-radius:10px;font-size:18px;margin:12px 0}
button{width:100%;padding:14px;border:0;border-radius:10px;background:#111;color:#fff;font-size:16px;font-weight:700;margin-top:8px}
button.secondary{background:#ddd;color:#111}.hidden{display:none}.result{margin-top:18px;padding:14px;border-radius:10px;background:#f2f2f2}
.warning{margin-top:18px;padding:12px;background:#fff7d6;border-left:4px solid #ffcc00;font-size:13px}
</style>
</head>
<body>
<div class="bar">MTN • Training Demo</div>
<div class="wrap"><div class="card">
<span class="badge">DEMO / TRAINING ONLY</span>

<section id="step1">
<h1>Demo Step 1</h1>
<p>Enter the six-digit <b>demo code</b> <b>123456</b>. It is checked only in this browser and is never transmitted.</p>
<input id="code" inputmode="numeric" maxlength="6" placeholder="Enter demo code">
<button onclick="submitDemoCode()">Continue</button>
<div id="msg1" class="result hidden"></div>
</section>

<section id="step2" class="hidden">
<h1>Waiting for review</h1>
<p>Your training request has been sent to the Telegram review panel.</p>
<div id="requestId" class="result"></div>
<div id="status" class="result">Status: pending…</div>
</section>

<section id="step3" class="hidden">
<h1>Approved</h1>
<p>The Telegram training reviewer approved this request.</p>
<button onclick="location.reload()">Start Again</button>
</section>

<section id="step4" class="hidden">
<h1>Rejected</h1>
<p>The Telegram training reviewer rejected this request. You can return to the demo entry step.</p>
<button onclick="retry()">Re-enter</button>
</section>

<div class="warning">This is a training simulation. It does not transmit, store, or request real OTPs, PINs, passwords, or mobile-money credentials.</div>
</div></div>

<script>
let requestId = null;
let timer = null;

async function submitDemoCode() {
  const code = document.getElementById("code").value.trim();
  const msg = document.getElementById("msg1");
  msg.classList.remove("hidden");

  if (code !== "123456") {
    msg.textContent = "For this training demo, use 123456.";
    return;
  }

  const response = await fetch("/api/demo-request", {method:"POST", headers:{"Content-Type":"application/json"}, body:"{}"});
  const data = await response.json();
  requestId = data.id;

  document.getElementById("step1").classList.add("hidden");
  document.getElementById("step2").classList.remove("hidden");
  document.getElementById("requestId").textContent = "Request ID: " + requestId;
  timer = setInterval(checkStatus, 1500);
}

async function checkStatus() {
  const response = await fetch("/api/demo-request/" + requestId);
  const data = await response.json();
  document.getElementById("status").textContent = "Status: " + data.status;

  if (data.status === "approved") {
    clearInterval(timer);
    document.getElementById("step2").classList.add("hidden");
    document.getElementById("step3").classList.remove("hidden");
  }

  if (data.status === "rejected") {
    clearInterval(timer);
    document.getElementById("step2").classList.add("hidden");
    document.getElementById("step4").classList.remove("hidden");
  }
}

function retry() {
  document.getElementById("step4").classList.add("hidden");
  document.getElementById("step1").classList.remove("hidden");
  document.getElementById("code").value = "";
}
</script>
</body>
</html>
